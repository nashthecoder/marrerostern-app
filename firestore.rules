service cloud.firestore {
  match /databases/{database}/documents {


    // Users collection
    match /users/{userId} {
      allow read: if true; // TEMP: allow all reads for dashboard aggregation
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }


    // Missions collection
    match /missions/{missionId} {
      allow read: if true; // TEMP: allow all reads for dashboard aggregation
      allow write: if isAdmin() || (request.auth != null && resource.data.assignedTo == request.auth.uid && isProvider());
    }

    // Reservations collection
    match /reservations/{reservationId} {
      allow read: if isAdmin()
        || (request.auth != null && (
          (resource.data.travelerId == request.auth.uid && isTraveler())
          || (resource.data.client == request.auth.token.email && isTraveler())
        ));
      allow write: if isAdmin();
    }


    // Incidents collection
    match /incidents/{incidentId} {
      allow read: if true; // TEMP: allow all reads for dashboard aggregation
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.reporterId == request.auth.uid && isOwner();
    }

    // Stock collection
    match /stock/{stockId} {
      allow read, write: if isAdmin() || (request.auth != null && resource.data.ownerId == request.auth.uid && isOwner());
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin() || (request.auth != null && (
        resource.data.ownerId == request.auth.uid && isOwner() ||
        resource.data.serviceProviderId == request.auth.uid && isProvider()
      ));
    }

    // Properties collection
    match /properties/{propertyId} {
      allow read, write: if isAdmin() || (request.auth != null && resource.data.ownerId == request.auth.uid && isOwner());
    }

    // Messages collection
    match /messages/{messageId} {
      allow read: if isAdmin()
        || (request.auth != null && (
          (resource.data.participants != null && (
            request.auth.uid in resource.data.participants ||
            request.auth.token.email in resource.data.participants
          ))
        ));
      allow create: if request.auth != null &&
        request.resource.data.recipient != null &&
        canSendMessage(request.auth.uid, request.auth.token.email, request.resource.data.recipient);
    }

    // Helper to check if sender can message recipient
    function canSendMessage(senderUid, senderEmail, recipientEmail) {
      let sender = get(/databases/$(database)/documents/users/$(senderUid)).data;
      let recipient = getUserByEmail(recipientEmail);
      // Admin can message anyone
      if (sender.role == 'admin') return true;
      // Owner can message admin and travelers
      if (sender.role == 'owner' && (recipient.role == 'admin' || recipient.role == 'traveler')) return true;
      // Traveler can message owners
      if (sender.role == 'traveler' && recipient.role == 'owner') return true;
      // Provider can message admins
      if (sender.role == 'provider' && recipient.role == 'admin') return true;
      return false;
    }

    // Helper to get user by email (inefficient, but Firestore rules are limited)
    function getUserByEmail(email) {
      return get(/databases/$(database)/documents/users/$(email));
    }

    // Sessions subcollection
    match /users/{userId}/devices/{deviceId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Documents collection
    match /documents/{docId} {
      allow read, write: if isAdmin() || (request.auth != null && resource.data.ownerId == request.auth.uid);
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read, write: if isAdmin() || (request.auth != null && (
        resource.data.travelerId == request.auth.uid && isTraveler() ||
        resource.data.serviceProviderId == request.auth.uid && isProvider() ||
        resource.data.ownerId == request.auth.uid && isOwner()
      ));
    }

    // Helper functions for role checks
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    function isProvider() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "provider";
    }
    function isOwner() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }
    function isTraveler() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "traveler";
    }

    // Audit logs collection (underscore, for correct access)
    match /audit_logs/{logId} {
      allow read: if true; // TEMP: allow all reads for dashboard aggregation
      allow write: if isAdmin();
    }
  }
}